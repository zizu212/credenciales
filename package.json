{
  "name": "credenciales",
  "version": "1.0.0",
  "description": "Sistema de escritorio Credenciales con Electron, Bootstrap 5 y MySQL local.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "build-mac": "electron-builder --mac --x64 --arm64",
    "pack": "electron-builder --dir"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bootstrap": "^5.3.0",
    "mysql": "^2.18.1",
    "xlsx": "^0.18.5",
    "adm-zip": "^0.5.9"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.credenciales.sistema",
    "productName": "Credenciales",
    "files": [
      "**/*",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
